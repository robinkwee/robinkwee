# Copy to .env.local for development. Everything is optional — the app degrades
# rather than crashing — but the "Required in production" block below is what
# makes booking and the AI chat actually work.

# ── Required in production ─────────────────────────────────────────────────

# Optional override for the Calendly scheduling link behind /call. Defaults to
# https://calendly.com/robinkwee/30-minute-meeting (see lib/calendly.ts), so
# booking works without setting this. Set it to point a preview or a fork at a
# different event type.
# Only https://calendly.com links are accepted; anything else is ignored with a
# build-log warning and the default is used. NEXT_PUBLIC_* values are inlined at
# build time, so changing this needs a redeploy to take effect.
NEXT_PUBLIC_CALENDLY_URL=

# Claude Haiku for the /api/chat widget.
ANTHROPIC_API_KEY=

# ── Data (server-side only — never expose the service-role key) ────────────

# Workout entries behind the /log heatmap. See supabase/README.md.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional ───────────────────────────────────────────────────────────────

# Shares rate-limit counters across serverless instances. Without them limits
# are per-instance only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# The /log commit heatmap. Needs a token with read:user scope.
GITHUB_TOKEN=
GITHUB_USERNAME=

# Bearer token for POST /api/habits/workout.
WORKOUT_LOG_SECRET=

# Canonical origin for metadata, sitemap and robots. Defaults to
# https://robinkwee.com.
NEXT_PUBLIC_SITE_URL=
