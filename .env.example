# Copy to .env.local for development. Everything is optional — the app degrades
# rather than crashing — but the "Required in production" block below is what
# makes booking and the AI surfaces actually work.

# ── Required in production ─────────────────────────────────────────────────

# Claude Haiku for /api/chat and the /call booking agent.
ANTHROPIC_API_KEY=

# Booking confirmations, calendar invites and reminders.
# Without it /api/book returns 503 and tells callers to email Robin instead.
RESEND_API_KEY=

# ── Booking ────────────────────────────────────────────────────────────────

# A PERMANENT Google Meet room, e.g. https://meet.google.com/abc-defg-hij.
# Do NOT use https://meet.google.com/new — it opens a different meeting for
# every person who clicks it, so the two parties never land in the same call.
# Left unset, invites promise a link instead of shipping a broken one.
MEET_LINK=

# Defaults: robinkwee@gmail.com / onboarding@resend.dev (Resend sandbox).
# Set BOOKING_FROM_EMAIL to an address on a domain verified in Resend before
# going live, or invites will land in spam.
BOOKING_NOTIFY_EMAIL=
BOOKING_FROM_EMAIL=

# ── Data (server-side only — never expose the service-role key) ────────────

# Bookings and workouts. See supabase/README.md for the schema.
# Without these, bookings still send invites but are not persisted and
# double-booking protection does not span serverless instances.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional ───────────────────────────────────────────────────────────────

# Shares rate-limit counters across serverless instances. Without them limits
# are per-instance only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# The /log commit heatmap. Needs a token with read:user scope.
GITHUB_TOKEN=
GITHUB_USERNAME=

# Bearer token for POST /api/habits/workout.
WORKOUT_LOG_SECRET=

# Hugging Face fallback for /api/kokoro when Edge TTS is unreachable.
HF_TOKEN=

# Canonical origin for metadata, sitemap and robots. Defaults to
# https://robinkwee.com.
NEXT_PUBLIC_SITE_URL=
